{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "claude-code": ["./.claude-plugin/types/claude-code/index.d.ts"],
      "claude-code/testing": ["./.claude-plugin/types/claude-code/index.d.ts"]
    },
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "include": ["hooks", "types", "./.claude-plugin/types/claude-code/index.d.ts"]
}
