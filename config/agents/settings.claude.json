{
  "model": "opus",
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "compact-plus@compact-plus": true,
    "kotlin-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "compact-plus": {
      "source": {
        "source": "github",
        "repo": "u-ichi/compact-plus"
      }
    }
  },
  "language": "japanese",
  "effortLevel": "medium",
  "tui": "default",
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "agent-state-record claude idle" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "agent-state-record claude running" }] }],
    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "agent-state-record claude running" }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "agent-state-record claude running" }] }],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "agent-state-record claude waiting" }] }],
    "Notification": [{ "matcher": "idle_prompt", "hooks": [{ "type": "command", "command": "agent-state-record claude idle" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "agent-state-record claude idle" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "agent-state-record claude clear" }] }]
  }
}
